{
  "name": "@formknot/core",
  "version": "0.1.0",
  "description": "Framework-neutral schema, validation, and conditional-logic engine for FormKnot dynamic forms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formknot/formknot.git",
    "directory": "packages/core"
  },
  "keywords": ["formknot", "forms", "schema", "validation", "json-schema"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
